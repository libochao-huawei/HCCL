#include <aicpu_api.h>
#include "common.h"

#ifdef __cplusplus
extern "C" {
#endif
extern __global__ __aicpu__ uint32_t HcclLaunchDoubleAllGatherAicpuKernelAsc(void *args);
#ifdef __cplusplus
}
#endif

namespace ops_hccl_double_allgather {

HcclResult LaunchKernelAsc(DoubleAllGatherParam &param, aclrtStream stream)
{
    constexpr uint32_t blockDim = 1;
    HcclLaunchDoubleAllGatherAicpuKernelAsc<<<blockDim, nullptr, stream>>>(&param, sizeof(DoubleAllGatherParam));
    aclError aclRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    CHK_PRT_RET(aclRet != ACL_SUCCESS, HCCL_ERROR("asc launch failed ret=%d", aclRet), HCCL_E_INTERNAL);
    return HCCL_SUCCESS;
}

}
