#include "p2p_send_recv_kernel.h"

using namespace ops_hccl_p2p_aiv;

#define CALL_P2P_AIV_KERNEL(type) \
    { \
        P2pSendRecvKernel<type> kernel; \
        kernel.Run(param); \
    }

extern "C" __global__ __aicore__ void HcclP2pAivKernel(P2pAivKernelParam param)
{
    switch (param.dataType) {
        case AscendC::HCCL_DATA_TYPE_INT8:
        case AscendC::HCCL_DATA_TYPE_UINT8:
            CALL_P2P_AIV_KERNEL(int8_t);
            break;
        case AscendC::HCCL_DATA_TYPE_INT16:
        case AscendC::HCCL_DATA_TYPE_UINT16:
        case AscendC::HCCL_DATA_TYPE_FP16:
        case AscendC::HCCL_DATA_TYPE_BFP16:
            CALL_P2P_AIV_KERNEL(uint16_t);
            break;
        case AscendC::HCCL_DATA_TYPE_INT32:
        case AscendC::HCCL_DATA_TYPE_UINT32:
            CALL_P2P_AIV_KERNEL(int32_t);
            break;
        case AscendC::HCCL_DATA_TYPE_FP32:
            CALL_P2P_AIV_KERNEL(float);
            break;
        case AscendC::HCCL_DATA_TYPE_INT64:
        case AscendC::HCCL_DATA_TYPE_UINT64:
        case AscendC::HCCL_DATA_TYPE_FP64:
            CALL_P2P_AIV_KERNEL(int64_t);
            break;
        default:
            break;
    }
}

EXPORT_AIV_META_INFO(HcclP2pAivKernel);
