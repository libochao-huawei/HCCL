{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/output/third_party/gtest_shared/include",
                "${workspaceFolder}/output/third_party/gtest_shared/googletest-1.14.0/googletest/include",
                "${workspaceFolder}/output/third_party/gtest_shared/googletest-1.14.0/googlemock/include",
                "${env:HOME}/Ascend/ascend-toolkit/latest/cann-8.5.0-beta.1/include",
                "${env:HOME}/Ascend/ascend-toolkit/latest/cann-8.5.0-beta.1/opp/built-in/include",
                "${env:HOME}/Ascend/ascend-toolkit/latest/cann-8.5.0-beta.1/opp/vendors/**/include",
                "/usr/include",
                "/usr/local/include"
            ],
            "defines": [
                "_GNU_SOURCE",
                "__linux__"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}
